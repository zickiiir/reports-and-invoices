# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env*.example files. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env.production
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

.pnpm-store

# local timesheet data (suppliers' actual files, don't push to git)
/data/

# Claude Code — local runtime state, not project config
.claude/scheduled_tasks.lock

# real personal data used as "crutches" while building the app (Perl port source,
# sample PDF outputs, spec) — never push to git
/perl-app/
/pdf-examples/
/zadani.md
# Scratches: ephemeral working files, never committed
vault/scratches/*
!vault/scratches/README.md

# Derived search indexes and reader page (hv-wiki) - generated, never committed
vault/wiki/.index.json
vault/wiki/.index.sqlite
vault/wiki/.index.sqlite-wal
vault/wiki/.index.sqlite-shm
vault/wiki/.wiki-browse.html

# Rules generated by the hv-essentials plugin
.claude/rules/_generated/
