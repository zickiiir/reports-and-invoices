{
  "name": "reports-and-invoices",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --webpack",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:rebuild": "docker compose -f docker-compose.dev.yml build --no-cache && docker compose -f docker-compose.dev.yml up",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:remove": "docker compose -f docker-compose.dev.yml down -v",
    "dev:docker:seed": "docker compose -f docker-compose.dev.yml exec app pnpm seed:dev",
    "dev:docker:db-push": "docker compose -f docker-compose.dev.yml exec app pnpm db:push",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "prod:docker": "docker compose --env-file .env.production up --build -d",
    "prod:docker:down": "docker compose --env-file .env.production down",
    "prod:docker:remove": "docker compose --env-file .env.production down -v",
    "seed": "tsx --env-file=.env scripts/seed/index.ts",
    "seed:dev": "tsx --env-file=.env scripts/seed/dev.ts",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/dropzone": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@replit/codemirror-emacs": "^6.1.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-table": "^9.2.4",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "bcryptjs": "^3.0.3",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.41.0",
    "jszip": "^3.10.1",
    "mantine-react-table": "2.0.0-beta.9",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.25",
    "nuqs": "^2.10.1",
    "postgres": "^3.4.9",
    "puppeteer": "^25.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-imask": "^7.6.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "webdav": "^5.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.23.0",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.11"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@11.20.0"
}
