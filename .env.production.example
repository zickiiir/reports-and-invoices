# Template for ".env.production" — your own production variables, kept separate from
# ".env" (that one's only for local development / `docker-compose.dev.yml`). Don't
# combine them, so a production password can't accidentally leak into the dev
# environment (or vice versa). Only ever commit filled-in values here — this ".example"
# file goes into git, ".env.production" itself does not.
#
# Used by `pnpm prod:docker` / `pnpm prod:docker:down`
# (docker compose --env-file .env.production ...).

# Your own production secret, NOT the same as in ".env" for development — generate one
# via `npx auth secret`.
AUTH_SECRET=""

# Password for the Postgres container in production (see docker-compose.yml).
POSTGRES_PASSWORD=""

# Root user (super_user) created automatically on the production container's startup
# (docker-entrypoint.sh) — EMAIL and PASSWORD are required for `pnpm prod:docker`.
SEED_EMAIL=""
SEED_PASSWORD=""
SEED_FIRSTNAME=""
SEED_SURNAME=""
